# Google Maps key (browser key). Restrict it by HTTP referrer in Google Cloud.
GOOGLE_MAPS_PLATFORM_KEY="REPLACE_WITH_YOUR_GOOGLE_MAPS_KEY"

# Optional: Sentry error tracking (leave empty to disable). Also add the DSN to the privacy page.
VITE_SENTRY_DSN=""

# Firebase web key for the "how busy is it?" reports (restricted by referrer in Google Cloud)
VITE_FIREBASE_API_KEY=""
